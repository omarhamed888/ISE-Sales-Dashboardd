rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /company/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
