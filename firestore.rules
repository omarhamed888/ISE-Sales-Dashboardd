rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getRole() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return getRole() == 'superadmin';
    }

    function isUserDocOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Legacy-safe read rule: many old docs don't match auth.uid as docId.
      // We allow authenticated reads so sign-in lookup by email and admin filters work.
      allow read: if isAuth();
      allow create: if (
        isAdmin()
        && request.resource.data.email is string
        && request.resource.data.role in ['sales', 'admin', 'superadmin']
        && request.resource.data.isActive is bool
      ) || (
        // Self-migration: user writes their own UID-keyed doc on first login (legacy doc ID fix)
        isAuth()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['sales', 'admin', 'superadmin']
        && request.resource.data.isActive is bool
      );
      allow update: if (isAdmin() || isUserDocOwner(userId));
      allow delete: if isSuperAdmin();
    }

    // Ad spend now flows in automatically from Meta API via Cloud Functions (Admin SDK
    // bypasses these rules). We keep admin read/update access for manual review/correction.
    match /ad_spend/{spendId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.date is string
        && request.resource.data.adId is string
        && request.resource.data.spend is number
        && request.resource.data.spend >= 0
        && request.resource.data.leadsReported is int
        && request.resource.data.leadsReported >= 0;
      allow delete: if isSuperAdmin();
    }

    match /reports/{reportId} {
      function isValidParsedData(pd) {
        return pd is map
          && pd.totalMessages is int
          && pd.totalMessages >= 0
          && pd.interactions is int
          && pd.interactions >= 0
          && pd.interactions <= pd.totalMessages
          && pd.funnel is map;
      }
      function isReportOwnerById() {
        return resource.data.salesRepId == request.auth.uid;
      }

      // Legacy reports may not have salesRepId and rely on salesRepName.
      function isReportOwnerByName() {
        return resource.data.salesRepId == null
          && resource.data.salesRepName is string
          && (
            resource.data.salesRepName == request.auth.token.name
            || resource.data.salesRepName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          );
      }

      // Rate-limit intent: one report/day per sales rep should be enforced in app/backend.
      allow read: if isAdmin() || (isAuth() && (isReportOwnerById() || isReportOwnerByName()));
      allow create: if isAuth()
        && request.resource.data.salesRepId is string
        && request.resource.data.date is string
        && request.resource.data.salesRepId == request.auth.uid
        && isValidParsedData(request.resource.data.parsedData);
      allow update: if isAdmin() || (
        isAuth()
        && (isReportOwnerById() || isReportOwnerByName())
        && request.resource.data.salesRepId == resource.data.salesRepId
        && request.resource.data.salesRepName == resource.data.salesRepName
        && isValidParsedData(request.resource.data.parsedData)
      );
      allow delete: if isSuperAdmin() || (isAuth() && (isReportOwnerById() || isReportOwnerByName()));
    }

    match /excuses/{excuseId} {
      // Rate-limit intent: excuse submissions should be throttled in app/backend.
      allow read: if isAdmin() || (isAuth() && resource.data.salesRepId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.salesRepId is string
        && request.resource.data.date is string
        && request.resource.data.salesRepId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isAdmin() || (isAuth() && resource.data.salesRepId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.salesRepId is string
        && request.resource.data.date is string
        && request.resource.data.salesRepId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (
        isAuth()
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in [
          'new_excuse',
          'missed_report',
          'team_milestone',
          'excuse_approved',
          'excuse_rejected',
          'reminder',
          'deadline_reminder',
          'pre_deadline_countdown',
          'customer_followup',
          'anomaly_alert'
        ]
        && request.resource.data.message is string
        && request.resource.data.read is bool
        && request.resource.data.read == false
      );
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    match /objection_categories/{categoryId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /insights/{insightId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    /** Client error telemetry (see runtime-logging-service). */
    match /runtime_logs/{logId} {
      allow create: if isAuth()
        && request.resource.data.source is string
        && request.resource.data.message is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || (isAuth() && resource.data.salesRepId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.salesRepId is string
        && request.resource.data.salesRepId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    function isDealOwnerSalesRep() {
      return resource.data.salesRepId == request.auth.uid;
    }

    /** Legacy deals saved with salesRepName only (no salesRepId). */
    function isDealOwnerByName() {
      return resource.data.salesRepId == null
        && (
          resource.data.salesRepName == request.auth.token.name
          || resource.data.salesRepName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        );
    }

    match /deals/{dealId} {
      allow read: if isAdmin()
        || (isAuth() && isDealOwnerSalesRep())
        || (isAuth() && isDealOwnerByName());
      allow create: if isAuth()
        && request.resource.data.salesRepId is string
        && request.resource.data.date is string
        && request.resource.data.salesRepId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuth()
        && (isDealOwnerSalesRep() || isDealOwnerByName())
        && request.resource.data.salesRepId == resource.data.salesRepId
      );
      allow delete: if isSuperAdmin() || (
        isAuth()
        && (isDealOwnerSalesRep() || isDealOwnerByName())
      );
    }

    match /ai_usage/{usageId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId is string
        && request.resource.data.type in ['parse', 'insights']
        && request.resource.data.success is bool
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /targets/{targetId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /metadata/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    match /app_config/{docId} {
      // meta_integration document has stricter rules — defined separately below.
      allow read: if docId != 'meta_integration';
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /app_config/meta_integration {
      allow read: if isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /ads/{adId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
